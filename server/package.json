{
  "name": "liars-bar-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:codenames-words": "tsx src/games/codenames/words/check.ts",
    "test:party": "node test/party.e2e.mjs",
    "test:domino": "node test/domino.test.mjs",
    "test": "npm run build && npm run test:engines && npm run test:domino && npm run test:domino-sim",
    "test:domino-sim": "node test/domino.sim.mjs",
    "test:spyfall": "node test/spyfall.e2e.mjs",
    "test:engines": "node test/engines.test.mjs",
    "test:chameleon": "node test/chameleon.e2e.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "nanoid": "^5.0.7",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "socket.io-client": "^4.7.5"
  }
}
