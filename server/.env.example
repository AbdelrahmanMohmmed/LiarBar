# Server port
PORT=3001

# Comma-separated list of allowed CORS origins.
#
# Leave UNSET to allow any origin (fine locally, never in production).
#
# Getting this wrong is the single most confusing failure in the project: the
# API is up, curl works, and every browser request fails with no server-side
# error at all. If clients sit on "connecting..." forever, check here first.
#
#   :5173  vite dev
#   :4173  vite preview (production build, served locally)
#
# When you move to a new domain, add it here AND redeploy the backend, or
# every player on the new domain sees "can't reach the server".
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://192.168.1.22:5173,https://liar-bar.vercel.app,http://www.liarbar.duckdns.org:3001,http://liarbar.duckdns.org:3001
